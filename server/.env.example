# Copy this file to .env and fill in the values.

# Backend port (bound to localhost in production, Nginx proxies /api to it)
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/softrate-blog for local MongoDB)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/softrate-blog?retryWrites=true&w=majority

# Long random string used to sign login tokens. CHANGE THIS.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Initial admin account created by `npm run seed`
# Demo credentials - CHANGE BEFORE PRODUCTION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# Allowed browser origin for CORS in development (Vite dev server)
CLIENT_URL=http://localhost:5173
